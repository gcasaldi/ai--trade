APCA_API_KEY_ID=your_alpaca_paper_key
APCA_API_SECRET_KEY=your_alpaca_paper_secret
APCA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Gmail requires an App Password; do not use your normal account password.
ALERT_SMTP_USER=your.sender@gmail.com
ALERT_SMTP_APP_PASSWORD=your_16_character_app_password

# Faster mobile push alerts through the Telegram Bot API.
ALERT_TELEGRAM_BOT_TOKEN=your_botfather_token
ALERT_TELEGRAM_CHAT_ID=your_numeric_chat_id
